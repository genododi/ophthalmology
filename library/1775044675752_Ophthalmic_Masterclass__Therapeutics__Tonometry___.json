              "Age/Sex",
              "Middle age/elderly (Avg 40), No sex predilection",
              "Young to middle age, Predominantly young males"
            ],
            [
              "Laterality",
              "Unilateral (90-95%)",
              "Unilateral recurrent"
            ],
            [
              "Symptoms",
              "Blur, haloes, NO PAIN",
              "Blur, haloes, ACUTE PAIN"
            ],
            [
              "IOP/Eye Appearance",
