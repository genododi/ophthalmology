      {
        "title": "Juvenile Idiopathic Arthritis (JIA) Screening Protocols",
        "icon": "school",
        "type": "process",
        "layout": "full_width",
        "color_theme": "green",
        "content": [
          "Step 1: Initial examination within 6 weeks of 1st JIA diagnosis.",
          "Step 2: High risk (ANA+, female, onset <7yrs) = 3-4 monthly review intervals.",
          "Step 3: Newly diagnosed Oligo/Psoriatic/Poly/Enthesitis = 2-month exams for the first 6 months regardless of ANA.",
          "Step 4: Polyarticular JIA = Every 3-4 months (may reduce to 6m after several years).",
          "Step 5: Systemic onset & Polyarticular RF+ve = Initial screening + Annual review.",
          "Step 6: Continue regular review until age 12.",
          "Urgent Referral: Any visual symptoms or suspicious ocular signs require slit lamp exam within 1 week."
        ]
