        "title": "Fuchs Heterochromic Uveitis vs. Posner-Schlossman Syndrome",
        "icon": "compare_arrows",
        "type": "table",
        "layout": "full_width",
        "color_theme": "green",
        "content": {
          "headers": [
            "Feature",
            "Fuchs Uveitic Syndrome (FUS)",
